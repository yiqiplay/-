@echo off
rem ===========================================================
rem  录制声音测试 —— 判断"声音异常"出在电脑端还是手机端
rem
rem  怎么用：
rem    1) 先在电脑上放一首歌或一段视频（必须正在出声！）
rem    2) 双击本文件
rem    3) 录完后打开桌面上的 LanControl-录制测试.wav 听
rem         · 正常  -> 问题出在手机端播放
rem         · 杂音  -> 问题出在电脑端采集
rem
rem  原理：录的是"本来要推送给手机的那份 PCM 数据"，
rem        所以它能一刀切开"电脑端采集"和"手机端播放"这两个环节。
rem  注意：Windows 的回环采集在电脑没有播放声音时不会推送数据，
rem        那种情况下录出来是空文件，属于正常现象，不是故障。
rem ===========================================================
setlocal
cd /d "%~dp0"

if not exist "LanControlServer.exe" (
  echo [错误] 本目录下没有 LanControlServer.exe
  echo        请把本文件放在程序目录里运行。
  echo.
  pause
  exit /b 1
)

echo ===========================================================
echo   录制声音测试（10 秒）
echo ===========================================================
echo.
echo   请确认：**电脑现在正在播放声音**（音乐/视频都可以）
echo   否则录出来会是空文件。
echo.
echo   按任意键开始录制……
pause >nul

LanControlServer.exe --audio-record --seconds 10

echo.
echo ===========================================================
echo   完成。文件在桌面上：LanControl-录制测试.wav
echo   用播放器打开听听：
echo     声音正常 -^> 问题在手机端播放
echo     也是杂音 -^> 问题在电脑端采集
echo ===========================================================
echo.
pause
exit /b 0
