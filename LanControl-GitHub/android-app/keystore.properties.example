# 签名密钥库配置示例
#
# 【重要】不要提交真正的密钥库和密码到公开仓库！
# 本仓库的 .gitignore 已排除 *.keystore / *.jks / keystore.properties。
#
# ── 第一步：生成你自己的密钥库 ──────────────────────────────
#
#   keytool -genkeypair -v ^
#     -keystore app/lancontrol.keystore ^
#     -storetype PKCS12 -alias lancontrol ^
#     -keyalg RSA -keysize 2048 -validity 10950 ^
#     -storepass 你的密码 -keypass 你的密码 ^
#     -dname "CN=你的名字, OU=你的名字, O=你的名字, L=Local, ST=Local, C=CN"
#
# ── 第二步：改 app/build.gradle 里的 signingConfigs.release ──
#
#   signingConfigs {
#       release {
#           storeFile file('lancontrol.keystore')
#           storePassword '你的密码'
#           keyAlias 'lancontrol'
#           keyPassword '你的密码'
#       }
#   }
#
# ── 注意 ────────────────────────────────────────────────────
#
# 换密钥库会导致新旧 APK 签名不匹配，用户必须先卸载旧版才能安装新版。
# 所以正式发布用的密钥库请务必备份好 —— 丢了就再也无法发布"可覆盖升级"的新版本。
#
# 若想改用 keystore.properties（更安全的做法，密码不进代码）：
#
#   # app/build.gradle
#   def ksProps = new Properties()
#   def ksFile = rootProject.file('keystore.properties')
#   if (ksFile.exists()) ksProps.load(new FileInputStream(ksFile))
#
#   signingConfigs {
#       release {
#           storeFile file(ksProps['storeFile'] ?: 'lancontrol.keystore')
#           storePassword ksProps['storePassword']
#           keyAlias ksProps['keyAlias']
#           keyPassword ksProps['keyPassword']
#       }
#   }
