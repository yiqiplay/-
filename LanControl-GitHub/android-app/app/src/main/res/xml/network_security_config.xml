<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 局域网内使用明文 HTTP/WebSocket，仅允许用户网络；不使用全局明文开关 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
